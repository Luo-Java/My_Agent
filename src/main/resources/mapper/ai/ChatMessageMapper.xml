<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.luo.ai.mapper.ChatMessageMapper">

    <!--
      跨会话关键词召回：在本用户「其他会话」的历史消息里做字面匹配。
      三个必须坚持的点：
      1) 归属靠 JOIN conversation 判定 —— chat_message 没有 user_id 列（与追踪可见性、成本配额同一口径）；
         缺了这个 JOIN 就是全站用户的历史互相可见。
      2) 强制排除当前会话 —— 当前会话的内容已经在记忆窗口里，再召回一遍只会重复占 token。
      3) 结果按「命中关键词个数」降序、同分按 id 降序 —— 排序表达式直接写在 ORDER BY 里而不做成 select 别名，
         这样 resultType 保持 ChatMessage（走列名自动映射），不引入 record 投影的列序/列数陷阱。
      关键词由调用方清洗（去掉 LIKE 通配符）后用 #{} 绑定，不做字符串拼接。
      LIMIT 由调用方传入（agent.cross-session.recall-limit），避免大表无界扫描。
    -->
    <select id="searchOwned" resultType="org.luo.ai.entity.ChatMessage">
        SELECT m.*
        FROM chat_message m
        JOIN conversation c ON c.id = m.conversation_id
        WHERE c.user_id = #{userId}
          AND m.conversation_id &lt;&gt; #{excludeConversationId}
          AND m.content IS NOT NULL
          AND m.content &lt;&gt; ''
          AND (
            <foreach collection="keywords" item="kw" separator=" OR ">
                m.content LIKE CONCAT('%', #{kw}, '%')
            </foreach>
          )
        ORDER BY (
            <foreach collection="keywords" item="kw" separator=" + ">
                (CASE WHEN m.content LIKE CONCAT('%', #{kw}, '%') THEN 1 ELSE 0 END)
            </foreach>
        ) DESC, m.id DESC
        LIMIT #{limit}
    </select>

</mapper>
