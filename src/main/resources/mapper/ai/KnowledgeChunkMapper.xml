<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.luo.ai.mapper.KnowledgeChunkMapper">

    <!--
      知识库关键词召回：在指定库内做多词项字面匹配，按「命中词项个数」降序。
      四个必须坚持的点：
      1) 只查检索需要的列 —— embedding 是 1024 维 JSON（约 20KB/行），关键词一路完全用不到向量，
         SELECT * 会让「补一路字面召回」变成「顺手把整库向量拉进堆」。
      2) ORDER BY 里直接写排序表达式，不做成 select 别名 —— 这样 resultType 保持 KnowledgeChunk
         （走列名自动映射），不引入 record 投影的列序/列数陷阱。
      3) 词项由调用方清洗后用 #{} 绑定，不做字符串拼接（词项来源是用户输入，不是可信数据）。
      4) LIMIT 由调用方传入（agent.rag.keyword-recall-scan-cap），避免 TEXT 列无界扫描。
    -->
    <select id="searchByKeyword" resultType="org.luo.ai.entity.KnowledgeChunk">
        SELECT c.id, c.kb_id, c.content, c.source
        FROM kb_chunk c
        WHERE c.kb_id IN
        <foreach collection="kbIds" item="kbId" open="(" separator="," close=")">
            #{kbId}
        </foreach>
          AND c.content IS NOT NULL
          AND c.content &lt;&gt; ''
          AND (
        <foreach collection="terms" item="t" separator=" OR ">
            c.content LIKE CONCAT('%', #{t}, '%')
        </foreach>
          )
        ORDER BY (
        <foreach collection="terms" item="t" separator=" + ">
            (CASE WHEN c.content LIKE CONCAT('%', #{t}, '%') THEN 1 ELSE 0 END)
        </foreach>
        ) DESC, c.id ASC
        LIMIT #{limit}
    </select>

</mapper>
